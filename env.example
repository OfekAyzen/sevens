# One shared Supabase project for the whole app — nobody who plays it ever
# sees these values. Copy this file to `.env` (gitignored) and fill in the
# real values from a project you create once:
#
#   1. supabase.com -> New project
#   2. SQL Editor -> New query -> paste src/sync/schema.sql -> Run
#   3. Project Settings -> API -> copy "Project URL" and the "anon public" key
#
# With no `.env` at all, the app runs fully local/solo (no group sync) — that's
# the default for `npm run dev` and for tests.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
